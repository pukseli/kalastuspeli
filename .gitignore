# Godot 4+ specific ignores
.godot/
.import/
export.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# OS / Editor files
.DS_Store
Thumbs.db
*.tmp
*~

# Local environment overrides (never commit secrets or host-specific prod overrides)
config/env/*.local.cfg

# Temporary slice SHA-256 lock created by lock_slice.sh
.agents/slice_lock.sha256
